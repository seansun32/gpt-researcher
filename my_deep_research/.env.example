# ============================================================
# 代理设置（避免代理拦截本地请求）
# 大小写两种形式都需要，兼容不同的 HTTP 库
# ============================================================
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

# ============================================================
# 内部搜索引擎
# ============================================================
INTERNAL_SEARCH_URL=http://www.xxx.com/search
INTERNAL_SEARCH_APP_ID=my-app-id
INTERNAL_SEARCH_TENANT_ID=my-tenant-id

# ============================================================
# 内部 Embedding API
# ============================================================
INTERNAL_EMBEDDING_URL=http://www.xxx.com/get_feature
INTERNAL_EMBEDDING_APP_ID=app_id
INTERNAL_EMBEDDING_MODEL=posong

# ============================================================
# 内部 LLM（OpenAI 兼容协议）
# ============================================================
OPENAI_API_KEY=your-internal-api-key
OPENAI_BASE_URL=http://www.xxx.com/modelops/v1
FAST_LLM=openai:your-model-name
SMART_LLM=openai:your-model-name
STRATEGIC_LLM=openai:your-model-name

# ============================================================
# gpt-researcher 配置（通过 CustomRetriever 对接搜索适配层）
# ============================================================
RETRIEVER=custom
RETRIEVER_ENDPOINT=http://127.0.0.1:8001/search

# ============================================================
# Embedding 配置（先用 custom 占位, 运行时由代码替换为内部实现）
# ============================================================
EMBEDDING=custom:dummy

# ============================================================
# 研究参数
# ============================================================
LANGUAGE=chinese
TOTAL_WORDS=2000
MAX_ITERATIONS=3
MAX_SEARCH_RESULTS_PER_QUERY=5
SIMILARITY_THRESHOLD=0.35
REPORT_FORMAT=APA
SCRAPER=bs

# Deep Research 参数
DEEP_RESEARCH_BREADTH=3
DEEP_RESEARCH_DEPTH=2
DEEP_RESEARCH_CONCURRENCY=4

# Token 限制（根据内部模型能力调整）
FAST_TOKEN_LIMIT=4000
SMART_TOKEN_LIMIT=8000
STRATEGIC_TOKEN_LIMIT=4000

# 关闭不需要的功能
IMAGE_GENERATION_ENABLED=False
CURATE_SOURCES=False
